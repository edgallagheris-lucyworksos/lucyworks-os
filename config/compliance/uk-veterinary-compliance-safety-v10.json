  "dpia": {
    "status":"draft_baseline_requires_controller_approval",
    "dataClasses":[
      {"class":"owner_client","personal":true,"specialCategory":false,"minimise":"No card data; separate contact and finance access"},
      {"class":"animal_clinical","personal":"context-dependent","specialCategory":false,"minimise":"Treat as confidential because linked to an identifiable owner"},
      {"class":"workforce_identity","personal":true,"specialCategory":false,"minimise":"Role, registration, competence and availability only"},
      {"class":"workforce_health","personal":true,"specialCategory":true,"minimise":"Separate access; store operational restriction rather than diagnosis where possible"},
      {"class":"audit_security","personal":true,"specialCategory":false,"minimise":"Accountability, security and legal-defence purpose only"}
    ],
    "highRisks":["large integrated client and workforce datasets","systematic monitoring","workforce health data","automated prioritisation or fatigue flags","clinical harm from wrong or unavailable records"],
    "mitigations":["least privilege","strong authentication","encryption","immutable attribution","data minimisation","segregation of duties","retention schedule","subject-rights workflow","breach response","human verification of AI","synthetic-first validation"],
    "controllerDecisions":["lawful basis by purpose","special-category condition and policy document","retention periods","international transfers","processor contracts","actual vendors","DPO consultation","residual high-risk acceptance"]
  },
  "safetyMethodology": {
    "name":"LucyWorks Veterinary Clinical and Operational Safety Method",
    "basis":"DCB0129/DCB0160 documentation structure adapted as good practice; no NHS applicability or certification claimed",
    "riskScore":"severity x likelihood, each 1 to 5",
    "acceptance":{"1-4":"controlled","5-9":"review","10-15":"senior acceptance required","16-25":"release blocked"},
    "documents":["safety plan","hazard log","verification evidence","safety case report","release decision","post-release monitoring","incident and CAPA process"]
  }
